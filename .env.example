# Copy to `.env` in this folder. Restart Metro after changes (`npx expo start -c` if URL sticks).
#
# Production (Railway) — set both; embedded at `eas build` time:
EXPO_PUBLIC_API_BASE=https://cliniflow-backend-clean-production.up.railway.app
EXPO_PUBLIC_API_URL=https://cliniflow-backend-clean-production.up.railway.app
#
# Local backend (same Wi‑Fi; use your Mac LAN IP, not localhost on a real phone):
# EXPO_PUBLIC_API_BASE=http://192.168.1.42:10000
# EXPO_PUBLIC_API_URL=http://192.168.1.42:10000
