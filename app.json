{
  "expo": {
    "scheme": "clinifly",
    "name": "Cliniflow",
    "slug": "clinifly-new",
    "version": "125.7",
    "icon": "./assets/images/icon.png",
    "owner": "erhanzorlu",
    "ios": {
      "bundleIdentifier": "net.clinifly.mobile",
      "buildNumber": "67",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.clinifly.mobile",
      "versionCode": 67,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "supportsTablet": true,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-image-picker",
      "./plugins/withPlayStoreMediaPermissions",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563EB",
          "defaultChannel": "chat_alerts",
          "sounds": ["./assets/audio/notification.wav"],
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "extra": {
      "API_URL": "https://cliniflow-backend-clean-production.up.railway.app",
      "eas": {
        "projectId": "f970fe3c-b598-44e7-9f04-c938e4a4321d"
      }
    }
  }
}
