{
  "expo": {
    "name": "Clinifly",
    "slug": "clinifly-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clinifly",
    "userInterfaceStyle": "automatic",
    "developmentClient": {
      "silentLaunch": true
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "net.clinifly.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Clinifly uses the camera to capture dental images for your treatment records.",
        "NSMicrophoneUsageDescription": "Clinifly uses the microphone for video recording during consultations.",
        "NSPhotoLibraryUsageDescription": "Clinifly accesses your photo library to upload dental images.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "cliniflow-backend-clean-production.up.railway.app": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "clinifly.net": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "buildNumber": "20"
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.clinifly.mobile",
      "versionCode": 30,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "clinifly"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Clinifly uses the camera to capture dental images for your treatment records."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Clinifly accesses your photo library to upload dental images."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-router",
      [
        "expo-file-system",
        {
          "fileSystemPermissions": [
            "READ_EXTERNAL_STORAGE",
            "WRITE_EXTERNAL_STORAGE"
          ]
        }
      ],
      "expo-notifications"
    ],
    "owner": "erhanzorlu",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f970fe3c-b598-44e7-9f04-c938e4a4321d"
      }
    }
  }
}
